fn test_matrix_within_struct_accesses() {
    // Test accesses to Cx2 matrices. There are additional tests in
    // `mat_cx2.wgsl`.

    var idx = 1;

    idx--;

    // loads
    let l0 = baz.m;
    let l1 = baz.m[0];
    let l2 = baz.m[idx];
    let l3 = baz.m[0][1];
    let l4 = baz.m[0][idx];
    let l5 = baz.m[idx][1];
    let l6 = baz.m[idx][idx];

